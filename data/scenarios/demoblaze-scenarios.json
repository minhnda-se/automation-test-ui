{
  "scenario": "Demoblaze E2E Test Scenarios",
  "config": {
    "tags": [
      "@demoblaze"
    ],
    "locatorFile": "demoblaze.json"
  },
  "testCases": [
    {
      "testId": "DB_NEW_01",
      "testName": "[Register] Register a brand-new random account",
      "steps": [
        {
          "action": "goto",
          "data": "https://www.demoblaze.com/"
        },
        {
          "action": "click",
          "page": "Demoblaze_Home",
          "element": "signupMenu"
        },
        {
          "action": "fill",
          "page": "Demoblaze_Auth",
          "element": "signupUsername",
          "data": "{{RANDOM_EMAIL}}",
          "storeAs": "NEW_USERNAME"
        },
        {
          "action": "fill",
          "page": "Demoblaze_Auth",
          "element": "signupPassword",
          "data": "Pass_{{RANDOM_STRING}}",
          "storeAs": "NEW_PASSWORD"
        },
        {
          "action": "click",
          "page": "Demoblaze_Auth",
          "element": "signupBtn"
        },
        {
          "action": "click",
          "page": "Demoblaze_Auth",
          "element": "signupCloseBtn"
        },
        {
          "action": "click",
          "page": "Demoblaze_Home",
          "element": "loginMenu"
        },
        {
          "action": "fill",
          "page": "Demoblaze_Auth",
          "element": "loginUsername",
          "data": "{{NEW_USERNAME}}"
        },
        {
          "action": "fill",
          "page": "Demoblaze_Auth",
          "element": "loginPassword",
          "data": "{{NEW_PASSWORD}}"
        },
        {
          "action": "click",
          "page": "Demoblaze_Auth",
          "element": "loginBtn"
        },
        {
          "action": "verify_text_contains",
          "page": "Demoblaze_Home",
          "element": "welcomeUser",
          "data": "{{NEW_USERNAME}}"
        }
      ],
      "description": "Registration is proved by logging in with the generated credentials: demoblaze reports the result of register() in a JS alert, and the framework has no dialog action to read it."
    },
