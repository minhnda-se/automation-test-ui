# Environment configuration - ALL VALUES ARE OPTIONAL.
#
# The framework runs entirely without this file. Copy it to .env only if you
# want to customize local browser/runner settings or enable optional AI locator
# healing:
#
#   cp .env.example .env
#
# Never commit a real .env - it is listed in .gitignore.

# Optional: Playwright browser channel.
# Default is bundled Chromium (matches CI). Set to "chrome" to launch locally
# installed Google Chrome instead.
# PW_CHANNEL=chrome

# Optional: Playwright action slow-motion delay in milliseconds.
# Defaults to 500 locally and 0 in CI.
# SLOW_MO=0

# Optional: Number of parallel Playwright workers.
# Defaults to 2 locally and 1 in CI.
# WORKERS=2

# Optional: Control PASS screenshot evidence capture (implemented in Phase 3).
# Set to "false" to capture screenshots only on failure.
# CAPTURE_EVIDENCE_ON_PASS=true

# Optional: Enables AI locator healing at runtime.
# Healing is ALSO off by default per scenario file; set "enableAutoHealing": true
# in a scenario's config block to opt that suite in.
# With no key set, healing is skipped with a warning and the test fails normally.
# A heal never modifies data/locators - proposals are written to
# reports/test-results/heal-report.json for review.
# OPENAI_API_KEY=sk-proj-xxxxxxxx
