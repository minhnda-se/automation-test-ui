  "testCases": [
    {
      "testId": "TC_01",
      "testName": "[Auth] Standard user logs in successfully",
      "steps": [
        {
          "action": "goto",
          "data": "https://www.saucedemo.com/"
        },
        {
          "action": "fill",
          "page": "LoginPage",
          "element": "usernameInput",
          "data": "standard_user"
        },
        {
          "action": "fill",
          "page": "LoginPage",
          "element": "passwordInput",
          "data": "secret_sauce"
        },
        {
          "action": "click",
          "page": "LoginPage",
          "element": "loginBtn"
        },
        {
          "action": "verify_visible",
          "page": "InventoryPage",
          "element": "cartIcon"
        }
      ],
      "tags": [
        "@ci"
      ]
