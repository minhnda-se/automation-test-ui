    "logo": "[data-testid=\"navbar-brand\"]",
    "homeLink": "[data-testid=\"navbar-brand\"], [data-testid=\"navbar-link-home\"]",
    "doctorsLink": "[data-testid=\"navbar-link-doctors\"], a[href=\"/doctors\"]",
    "searchLink": "[data-testid=\"navbar-link-search\"], a[href=\"/search\"]",
    "loginLink": "[data-testid=\"navbar-login-link\"], [data-testid=\"navbar-login-button\"]",
    "registerLink": "[data-testid=\"navbar-register-link\"], [data-testid=\"navbar-register-button\"]",
