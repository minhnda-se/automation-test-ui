{
  "config": {
    "locatorFile": "booking-locators.json"
  },
  "scenario": "Booking App - Complete Test Suite",
  "testCases": [
    {
      "testId": "TC_REG_01",
      "testName": "Successful Registration [US1_AC1, US1_AC3, US1_AC4]",
      "description": "Verify that a new user can successfully register with valid details.",
      "steps": [
        {
          "action": "goto",
          "data": "https://booking-appointment-system-psi.vercel.app/auth/register"
        },
        {
          "action": "verify_visible",
          "page": "RegisterPage",
          "element": "createAccountButton"
        },
        {
          "action": "fill",
          "page": "RegisterPage",
          "element": "fullNameInput",
          "data": "QA Tester"
        },
        {
          "action": "fill",
          "page": "RegisterPage",
          "element": "emailInput",
          "data": "{{RANDOM_EMAIL}}"
        },
        {
          "action": "fill",
          "page": "RegisterPage",
          "element": "passwordInput",
          "data": "Test@123456"
        },
        {
          "action": "fill",
          "page": "RegisterPage",
          "element": "phoneInput",
          "data": "0912345678"
        },
        {
          "action": "click",
          "page": "RegisterPage",
          "element": "createAccountButton"
        },
        {
          "action": "verify_url_contains",
          "data": "bookings/me"
        }
      ]
    },
    {
      "testId": "TC_REG_02",
      "testName": "Registration with Duplicate Email [US1_AC5]",
      "description": "Verify system rejects registration with an existing email.",
      "steps": [
        {
          "action": "goto",
          "data": "https://booking-appointment-system-psi.vercel.app/auth/register"
        },
        {
          "action": "fill",
          "page": "RegisterPage",
          "element": "fullNameInput",
          "data": "Existing User"
        },
        {
          "action": "fill",
          "page": "RegisterPage",
          "element": "emailInput",
          "data": "khoatdq86@gmail.com"
        },
        {
          "action": "fill",
          "page": "RegisterPage",
          "element": "passwordInput",
          "data": "Test@123456"
        },
        {
          "action": "fill",
          "page": "RegisterPage",
          "element": "phoneInput",
          "data": "0912345678"
        },
        {
          "action": "click",
          "page": "RegisterPage",
          "element": "createAccountButton"
        },
        {
          "action": "verify_text_contains",
          "page": "RegisterPage",
          "element": "errorMessage",
          "data": "Email đã tồn tại."
        }
      ]
    },
    {
      "testId": "TC_LOG_01",
      "testName": "Successful Login [US2_AC3]",
      "description": "Verify that a registered user can log in successfully.",
      "dataTable": [
        {
          "email": "Test12345678@gmail.com",
          "password": "A123456789"
        }
      ],
      "steps": [
        {
          "action": "goto",
          "data": "https://booking-appointment-system-psi.vercel.app/auth/login"
        },
        {
          "action": "fill",
          "page": "LoginPage",
          "element": "emailInput",
          "data": "{{email}}"
        },
        {
          "action": "fill",
          "page": "LoginPage",
          "element": "passwordInput",
          "data": "{{password}}"
        },
        {
          "action": "click",
          "page": "LoginPage",
          "element": "loginButton"
        },
        {
          "action": "verify_visible",
          "page": "HomePage",
          "element": "userName"
        }
      ]
    },
    {
      "testId": "TC_LOG_02",
      "testName": "Failed Login - Invalid Credentials [US2_AC4]",
      "description": "Verify system displays error on invalid login.",
      "steps": [
        {
          "action": "goto",
          "data": "https://booking-appointment-system-psi.vercel.app/auth/login"
        },
        {
          "action": "fill",
          "page": "LoginPage",
          "element": "emailInput",
          "data": "invalid@email.com"
        },
        {
          "action": "fill",
          "page": "LoginPage",
          "element": "passwordInput",
          "data": "WrongPass"
        },
        {
          "action": "click",
          "page": "LoginPage",
          "element": "loginButton"
        },
        {
          "action": "verify_text_contains",
          "page": "LoginPage",
          "element": "errorMessage",
          "data": "Invalid credentials"
        }
      ]
    }
  ]
}
