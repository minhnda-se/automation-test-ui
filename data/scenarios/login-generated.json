{
  "$schema": "../../schema/scenario-schema.json",
  "config": {
    "tags": [
      "@saucedemo"
    ],
    "locatorFile": "swag-lab.json"
  },
  "scenario": "User login",
  "testCases": [
    {
      "testId": "BDD_LOGIN_01",
      "testName": "Successful login with a standard account",
      "steps": [
        {
          "action": "goto",
          "data": "https://www.saucedemo.com/"
        },
        {
          "action": "fill",
          "data": "standard_user",
          "element": "usernameInput",
          "page": "LoginPage"
        },
        {
          "action": "fill",
          "data": "secret_sauce",
          "element": "passwordInput",
          "page": "LoginPage"
        },
        {
          "action": "click",
          "element": "loginBtn",
          "page": "LoginPage"
        },
        {
          "action": "verify_visible",
          "element": "cartIcon",
          "page": "InventoryPage"
        }
      ]
    }
  ]
}
