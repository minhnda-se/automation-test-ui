    "logoutBtn": "[data-testid=\"navbar-logout-button\"]"
  },
  "RegisterPage": {
    "nameInput": "[data-testid=\"register-input-name\"]",
    "emailInput": "[data-testid=\"register-input-email\"]",
    "passwordInput": "[data-testid=\"register-input-password\"]",
    "phoneInput": "[data-testid=\"register-input-phone\"]",
    "registerError": "[data-testid=\"register-error\"], [data-testid=\"toast-container\"]",
    "submitBtn": "[data-testid=\"register-submit-button\"]",
    "loginLink": "[data-testid=\"register-login-link\"]"
  },
  "LoginPage": {
    "emailInput": "[data-testid=\"login-email-input\"]",
    "passwordInput": "[data-testid=\"login-password-input\"]",
    "loginError": "[data-testid=\"login-error\"], [data-testid=\"toast-container\"]",
    "loginBtn": "[data-testid=\"login-submit-button\"]",
    "registerLink": "[data-testid=\"login-register-link\"]"
  },
  "DoctorsPage": {
    "specialtyFilter": "[data-testid=\"doctors-filter-specialty-select\"]",
    "cityFilter": "[data-testid=\"doctors-filter-city-input\"]",
    "sortSelect": "[data-testid=\"doctors-filter-sort-select\"]",
    "resetFilterBtn": "[data-testid=\"doctors-filter-reset-button\"]",
    "doctorCard": "[data-testid^=\"doctor-card-\"]",
    "firstDoctorDetailLink": "[data-testid$=\"-detail-link\"], a[href*=\"/doctors/\"]"
  },
  "DoctorDetailPage": {
    "doctorName": "[data-testid=\"doctor-detail-name\"]",
    "specialtyBadge": "[data-testid=\"doctor-detail-specialty\"]",
    "experienceText": "[data-testid=\"doctor-detail-experience\"]",
    "ratingText": "[data-testid=\"doctor-detail-rating\"]",
    "feeText": "[data-testid=\"doctor-detail-fee\"]",
    "bookNowBtn": "[data-testid=\"doctor-detail-book-now-link\"], a[href*=\"/bookings/new\"]"
  },
  "BookingNewPage": {
    "doctorSelect": "[data-testid=\"booking-new-doctor-select\"]",
    "calendarDateButton": "button[data-testid^=\"booking-calendar-date-\"]",
    "slotButton": "button[data-testid^=\"booking-slot-item-\"]",
    "slotEmpty": "[data-testid=\"booking-new-slot-empty\"]",
    "notesInput": "[data-testid=\"booking-new-notes-input\"]",
    "bookingError": "[data-testid=\"booking-new-error\"], [data-testid=\"toast-container\"]",
    "submitBookingBtn": "[data-testid=\"booking-new-submit-button\"]"
