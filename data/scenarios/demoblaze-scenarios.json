{
  "scenario": "Demoblaze E2E Test Scenarios",
  "config": {
    "tags": ["@demoblaze"],
    "locatorFile": "demoblaze.json"
  },
  "testCases": [
    {
      "testId": "DB_NEW_01",
      "testName": "[Register] Đăng ký tài khoản ngẫu nhiên mới 100%",
      "steps": [
        { "action": "goto", "data": "https://www.demoblaze.com/" },
        { "action": "click", "page": "Demoblaze_Home", "element": "signupMenu" },

        {
          "action": "fill",
          "page": "Demoblaze_Auth",
          "element": "signupUsername",
          "data": "{{RANDOM_EMAIL}}"
        },

        {
          "action": "fill",
          "page": "Demoblaze_Auth",
          "element": "signupPassword",
          "data": "Pass_{{RANDOM_STRING}}"
        },

        { "action": "click", "page": "Demoblaze_Auth", "element": "signupBtn" }
      ]
    },
    {
      "testId": "DB_01",
      "testName": "[Nav] Truy cập trang chủ và kiểm tra Logo",
      "steps": [
        { "action": "goto", "data": "https://www.demoblaze.com/" },
        { "action": "verify_visible", "page": "Demoblaze_Home", "element": "brandLogo" }
      ]
    },
    {
      "testId": "DB_02",
      "testName": "[Auth] Mở modal Đăng nhập",
      "steps": [
        { "action": "goto", "data": "https://www.demoblaze.com/" },
        { "action": "click", "page": "Demoblaze_Home", "element": "loginMenu" },
        { "action": "verify_visible", "page": "Demoblaze_Auth", "element": "loginUsername" }
      ]
    },
    {
      "testId": "DB_03",
      "testName": "[Auth] Đóng modal Đăng nhập bằng nút Close",
      "steps": [
        { "action": "goto", "data": "https://www.demoblaze.com/" },
        { "action": "click", "page": "Demoblaze_Home", "element": "loginMenu" },
        { "action": "click", "page": "Demoblaze_Auth", "element": "loginCloseBtn" }
      ]
    },
    {
      "testId": "DB_04",
      "testName": "[Auth] Mở modal Đăng ký (Sign up)",
      "steps": [
        { "action": "goto", "data": "https://www.demoblaze.com/" },
        { "action": "click", "page": "Demoblaze_Home", "element": "signupMenu" },
        {
          "action": "verify_visible",
          "page": "Demoblaze_Auth",
          "element": "signupUsername"
        }
      ]
