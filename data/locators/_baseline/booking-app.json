  "MyBookingsPage": {
    "myBookingsPage": "[data-testid=\"my-bookings-page\"]",
    "myBookingsTitle": "[data-testid=\"my-bookings-title\"]",
    "tabUpcoming": "[data-testid=\"my-bookings-tab-upcoming\"]",
    "tabPast": "[data-testid=\"my-bookings-tab-past\"]",
    "tabCanceled": "[data-testid=\"my-bookings-tab-canceled\"]",
    "emptyState": "[data-testid=\"my-bookings-empty-state\"]",
    "bookingCard": "[data-testid^=\"my-bookings-item-\"], [data-testid^=\"booking-card-\"]",
    "cancelBookingBtn": "[data-testid$=\"-cancel-button\"], [data-testid$=\"-cancel-link\"], a[href*=\"/cancel\"]",
    "confirmCancelBtn": "[data-testid=\"booking-cancel-confirm-button\"]"
